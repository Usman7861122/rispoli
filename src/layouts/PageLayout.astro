---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
interface Props { title: string; eyebrow?: string; lede?: string; description?: string; image?: string; imageAlt?: string; noindex?: boolean }
const { title, eyebrow, lede, description, image, imageAlt, noindex } = Astro.props;
---
<BaseLayout title={title} description={description ?? lede} noindex={noindex}>
  <PageHero {title} {eyebrow} {lede} {image} {imageAlt} />
  <slot />
</BaseLayout>
