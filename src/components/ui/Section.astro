---
interface Props { id?: string; tone?: 'light' | 'bone' | 'dark'; class?: string }
const { id, tone = 'light', class: cls = '' } = Astro.props;
const tones = { light: 'bg-white', bone: 'bg-bone', dark: 'bg-ink text-white' };
---
<section id={id} class={`${tones[tone]} py-20 md:py-28 ${cls}`}>
  <div class="mx-auto max-w-7xl px-5"><slot /></div>
</section>
