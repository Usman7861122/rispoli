---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
---
<section id="hero" class="relative flex min-h-[85vh] items-end bg-ink text-white">
  <!-- TODO: hero photo (16:9 desktop, 4:3 phone) with a soft dark tint on the left -->
  <div class="relative mx-auto w-full max-w-7xl px-5 pb-20 pt-40">
    <p class="text-xs uppercase tracking-[0.25em] text-white/70">Interventional pain medicine and physiatry</p>
    <!-- One real H1 only. If we draw desktop and mobile copy twice, desktop uses role="heading" aria-level="1" -->
    <h1 class="mt-4 max-w-3xl font-display text-4xl md:text-6xl">{site.tagline}</h1>
    <p class="mt-6 max-w-xl text-lg text-white/80">{site.description}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={site.bookingUrl} external>Book a consultation</Button>
      <Button href="/services/physiatry-rehabilitation" variant="outline">Non-surgical care</Button>
    </div>
  </div>
</section>
