---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/ui/Section.astro';
import LocalSection from '../../components/sections/LocalSection.astro';
import Services from '../../components/sections/Services.astro';
import { conditions } from '../../data/conditions';
import { services } from '../../data/services';
import { localFor } from '../../data/local';

export function getStaticPaths() {
  return conditions.map((c) => ({ params: { slug: c.slug }, props: { condition: c } }));
}
const { condition } = Astro.props;
const l = localFor(condition.title);
const others = services.filter((s) => !condition.relatedServices.includes(s.slug)).map((s) => s.slug);
---
<PageLayout title={l.title} eyebrow="Conditions" lede={condition.short}>
  <Section>
    <p class="text-ink/70">Overview, causes, symptoms and red flags, diagnosis, treatment, living well, FAQ. TODO.</p>
  </Section>
  <LocalSection topic={condition.title} />
  <Services exclude={others} />
</PageLayout>
