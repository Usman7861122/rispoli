---
// Hub page that lists every spine injection page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ServiceHero, HubTreatments, HubGuide, HubOffices, ServiceProviders, ServiceRelated } from '../../components/react/ServiceBlocks';
import { hub } from '../../data/spine-injections';
import { team } from '../../data/team';
import { locations } from '../../data/locations';
import { site } from '../../data/site';

const everyone = [...team.lead, ...team.peers];
const slugs = [...new Set(hub.pages.flatMap((p: any) => p.providerSlugs))];
const providerCards = slugs
  .map((s) => everyone.find((p) => p.slug === s))
  .filter((p: any) => !!p)
  .map((p: any) => ({ slug: p.slug, name: p.name, role: p.role, image: p.image, position: p.position, alt: p.imageAlt, href: p.href,
    line: hub.pages.filter((x: any) => x.providerSlugs.includes(p.slug)).map((x: any) => x.hero.name.replace(/^The /, '')).join(' · ') }));
const offices = locations.offices.map((o: any) => ({
  slug: o.slug, city: o.city, street: o.street, cityLine: o.cityLine, image: o.image, position: o.position,
  links: hub.pages.filter((p: any) => p.locationSlugs.includes(o.slug)).map((p: any) => ({ label: p.hero.name.replace(/^The /, ''), href: `/services/${p.slug}/${o.slug}` })),
}));
---
<BaseLayout title={hub.seoTitle} description={hub.seoDescription}>
  <ServiceHero client:load data={hub.hero} photo={hub.photo} bookingUrl={site.bookingUrl} phone={site.phone} />
  <HubTreatments client:visible {...hub.treatments} />
  <HubGuide client:visible {...hub.guide} />
  <ServiceProviders client:visible title="Doctors who treat this." accent="treat this." text="Our doctors perform these procedures. The line under each name shows which ones." cards={providerCards} />
  <HubOffices client:visible title={hub.officesTitle} accent={hub.officesAccent} text={hub.officesText} offices={offices} bookingUrl={site.bookingUrl} phone={site.phone} />
  <ServiceRelated client:visible items={hub.related} />
</BaseLayout>
