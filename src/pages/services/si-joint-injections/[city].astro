---
// City versions of /services/si-joint-injections.
import ServicePageView from '../../../components/ServicePageView.astro';
import { siJoint } from '../../../data/si-joint-injections';
import { locations } from '../../../data/locations';

export function getStaticPaths() {
  return siJoint.locationSlugs.map((slug) => ({
    params: { city: slug },
    props: { office: locations.offices.find((o) => o.slug === slug)! },
  }));
}
const { office } = Astro.props;
---
<ServicePageView d={siJoint} office={office} />
