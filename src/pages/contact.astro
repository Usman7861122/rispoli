---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SimpleHero, ContactBlocks } from '../components/react/PageBlocks';
import { locations } from '../data/locations';
import { allServices } from '../data/service-pages';
import { site } from '../data/site';
const offices = locations.offices.map((o) => ({
  slug: o.slug, city: o.city, street: o.street, cityLine: o.cityLine, image: o.image, position: o.position,
  mapsHref: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${o.street}, ${o.cityLine}`)}`,
}));
const services = allServices.map((s) => s.hero.name.replace(/^The /, ''));
---
<BaseLayout title="Contact Us" description="Contact Westside Interventional Pain & Physiatry. Request an appointment, call 310-405-0595, or visit our Santa Monica, Marina Del Rey or Newport Beach office.">
  <SimpleHero client:load eyebrow="Contact" title="Let’s get you moving again." accent="moving" lede="Request an appointment, call the office, or visit one of our three locations." actions={[{ label: 'Book appointment', href: site.bookingUrl, external: true, primary: true }, { label: `Call ${site.phone}`, href: `tel:${site.phone.replace(/[^\d+]/g, '')}` }]} />
  <ContactBlocks client:load offices={offices} services={services} phone={site.phone} fax={site.fax} email={site.email} hours={[...site.hours]} api={site.contactApi} />
</BaseLayout>
